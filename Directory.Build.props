<Project>
  <!--
    One codebase, three Umbraco lines. UmbracoMajor selects the line: 18 (default), 17 or 19.
      dotnet build -p:UmbracoMajor=17
    It sets the CMS range, the package version, the UMBRACO_17 / UMBRACO_18 / UMBRACO_19 constants, the target framework
    (19 is net11.0, 17 and 18 are net10.0, via LineTfm), and a separate lock file and
    obj folder per line, so switching lines never reuses the other line's restore.

    Lock files describe the floor: they are generated and committed at the default values of UmbracoTestVersion and
    UmbracoDemoVersion (the line's floor), and the floor CI legs restore in locked mode. The latest-minor CI legs override
    these two properties (17.*, 18.* or, for 19, 19.*-*) and restore unlocked (force-evaluate, RestoreLockedMode=false);
    the lock files they rewrite are never committed. Nothing else overrides these properties.

    Floors never go below 17.8.2 / 18.3.2 / 19.0.0-rc1: 17.8.2 and 18.3.2 sit above the 27 Oct 2026 advisories and
    GHSA-348f-9mg8-rhv4 (Examine members index, published 17 Nov 2026, a repository advisory osv does not see). Lowering
    one needs a security review first.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">18</UmbracoMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoFloor>17.8.2</UmbracoFloor>
    <UmbracoNextMajor>18.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_17</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoFloor>18.3.2</UmbracoFloor>
    <UmbracoNextMajor>19.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '19'">
    <UmbracoFloor>19.0.0-rc1</UmbracoFloor>
    <UmbracoNextMajor>20.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_19</DefineConstants>
    <LineTfm>net11.0</LineTfm>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' != '19'">
    <LineTfm>net10.0</LineTfm>
  </PropertyGroup>
  <Target Name="ValidateUmbracoMajor" BeforeTargets="Restore;Build;CoreCompile" Condition="'$(UmbracoMajor)' != '17' and '$(UmbracoMajor)' != '18' and '$(UmbracoMajor)' != '19'">
    <Error Text="UmbracoMajor must be 17, 18 or 19 (got '$(UmbracoMajor)')." />
  </Target>

  <PropertyGroup>
    <!-- 17.x and 18.x ship from one tag release/<PackageMinor>.<PackagePatch>-<suffix>; the major comes from the line. -->
    <PackageMinor>0</PackageMinor>
    <PackagePatch>2</PackagePatch>
    <PackageVersionSuffix></PackageVersionSuffix>
    <!-- The -alpha upper bound excludes the next major's prereleases: NuGet orders 19.0.0-rc1 below 19.0.0, so a plain
         [18.3.2, 19.0.0) would let an Umbraco 19 release-candidate site install the 18.x package silently. With -alpha
         NuGet warns (NU1608) instead; it is a warning, not a block, unless the site treats warnings as errors.
         Not -0: nuget.org rejects a manifest whose dependency version has a prerelease label starting with a digit
         (400 "invalid Version: '20.0.0-0'"), even though pack and restore accept it. -->
    <UmbracoRange>[$(UmbracoFloor), $(UmbracoNextMajor)-alpha)</UmbracoRange>
    <UmbracoTestVersion Condition="'$(UmbracoTestVersion)' == ''">$(UmbracoFloor)</UmbracoTestVersion>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">$(UmbracoFloor)</UmbracoDemoVersion>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(UmbracoMajor).lock.json</NuGetLockFilePath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(UmbracoMajor)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/$(UmbracoMajor)/</BaseOutputPath>
    <!-- Per-line obj/bin folders: without this the other line's generated .cs files are globbed in (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <!-- Audit direct and transitive dependencies; build/check-vulnerable.sh is the PR and release gate. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
