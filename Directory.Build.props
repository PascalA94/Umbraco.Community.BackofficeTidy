<Project>
  <!--
    One codebase, two Umbraco lines. UmbracoMajor selects the line: 18 (default) or 17.
      dotnet build -p:UmbracoMajor=17
    It sets the CMS range, the package version, the UMBRACO_17 / UMBRACO_18 constants, and a separate lock file and
    obj folder per line, so switching lines never reuses the other line's restore.

    Lock files describe the floor: they are generated and committed at the default values of UmbracoTestVersion and
    UmbracoDemoVersion (the line's floor), and the floor CI legs restore in locked mode. The latest-minor CI legs override
    these two properties (17.* or 18.*) and restore unlocked (force-evaluate, RestoreLockedMode=false); the lock files
    they rewrite are never committed. Nothing else overrides these properties.

    Floors never go below 17.8.0 / 18.3.0: they sit above the 27 Oct 2026 advisories. Lowering one needs a security
    review first.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">18</UmbracoMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <UmbracoFloor>17.8.0</UmbracoFloor>
    <UmbracoNextMajor>18.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_17</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <UmbracoFloor>18.3.0</UmbracoFloor>
    <UmbracoNextMajor>19.0.0</UmbracoNextMajor>
    <DefineConstants>$(DefineConstants);UMBRACO_18</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateUmbracoMajor" BeforeTargets="Restore;Build;CoreCompile" Condition="'$(UmbracoMajor)' != '17' and '$(UmbracoMajor)' != '18'">
    <Error Text="UmbracoMajor must be 17 or 18 (got '$(UmbracoMajor)')." />
  </Target>

  <PropertyGroup>
    <!-- 17.x and 18.x ship from one tag release/<PackageMinor>.<PackagePatch>-<suffix>; the major comes from the line. -->
    <PackageMinor>0</PackageMinor>
    <PackagePatch>0</PackagePatch>
    <PackageVersionSuffix>alpha.1</PackageVersionSuffix>
    <UmbracoRange>[$(UmbracoFloor), $(UmbracoNextMajor))</UmbracoRange>
    <UmbracoTestVersion Condition="'$(UmbracoTestVersion)' == ''">$(UmbracoFloor)</UmbracoTestVersion>
    <UmbracoDemoVersion Condition="'$(UmbracoDemoVersion)' == ''">$(UmbracoFloor)</UmbracoDemoVersion>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.$(UmbracoMajor).lock.json</NuGetLockFilePath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(UmbracoMajor)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/$(UmbracoMajor)/</BaseOutputPath>
    <!-- Per-line obj/bin folders: without this the other line's generated .cs files are globbed in (CS0579). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <!-- Audit direct and transitive dependencies; build/check-vulnerable.sh is the PR and release gate. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
